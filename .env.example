# Loopback development only. Configure separate secrets and HTTPS cookies on Render.
DATABASE_URI=sqlite:///ffrh-local.db
FLASK_SECRET_KEY=ffrh-local-flask-secret-change-me
JWT_SECRET_KEY=ffrh-local-jwt-secret-change-me-123
JWT_COOKIE_SECURE=false

# Allow the seed command to initialize an empty SQLite database.
FFRH_LOCAL_DEMO=true

# Profile photo uploads are optional for the local demo.
AWS_EC2_METADATA_DISABLED=true
